PORT=3000
NODE_ENV=development

# Database Configuration (Option A: Individual Variables - Local Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=caregiving_db
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false

# Database Configuration (Option B: Connection String - Cloud Providers like Render PostgreSQL, Neon, Supabase)
# DATABASE_URL=postgresql://user:password@ep-host.neon.tech/neondb?sslmode=require

# Authentication Configuration
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h

# Security & CORS Configuration
CORS_ORIGIN=*

# Administrative Boot Seeding Configuration
ADMIN_EMAIL=admin@careconnect.com
ADMIN_PASSWORD=AdminSecret123!
ADMIN_AUTO_SEED=true

# Telemetry / Observability
OBSERVE_APP_KEY=YOUR_APP_KEY
OBSERVE_APP_SECRET=YOUR_APP_SECRET
