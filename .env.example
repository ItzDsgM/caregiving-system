PORT=3000
NODE_ENV=development

# Database Configuration (Option A: Individual Variables - Local Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=caregiving_db
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false

# Database Configuration (Option B: Connection String - Cloud Providers like Neon, Supabase, Render, Vercel Postgres)
# DATABASE_URL=postgresql://user:password@ep-host.neon.tech/neondb?sslmode=require

# Authentication Configuration
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h

