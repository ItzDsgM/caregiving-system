# ==============================================================================
# CareConnect - Production Environment Variables (Render + Neon)
# ==============================================================================

# --- Backend Service (Render) -------------------------------------------------
NODE_ENV=production

# Neon PostgreSQL Connection String (paste your Neon link here or in Render Env Vars)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_SSL=true
DB_SYNCHRONIZE=true

# Authentication
JWT_SECRET=change_this_to_a_secure_random_secret
JWT_EXPIRES_IN=24h

# CORS: Set to your Render Frontend URL (no trailing slash), or * to allow all
CORS_ORIGIN=https://careconnect-frontend.onrender.com

# Initial Admin Seed
ADMIN_EMAIL=admin@careconnect.com
ADMIN_PASSWORD=AdminSecret123!
ADMIN_AUTO_SEED=true

# --- Frontend Service (Render) ------------------------------------------------
# Must be set at BUILD time in Render so Next.js bakes it into the client bundle
NEXT_PUBLIC_API_URL=https://careconnect-backend.onrender.com/api/v1

# ==============================================================================
# Local Development / Docker (Optional - uncomment if running local Postgres)
# ==============================================================================
# PORT=3000
# FRONTEND_PORT=3001
# NODE_ENV=development
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=careconnect_db
# DB_SSL=false
# NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
