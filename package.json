{
  "name": "caregiving-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:backend": "bun --filter backend start:dev",
    "dev:frontend": "bun --filter frontend dev",
    "build": "bun --filter '*' build",
    "build:backend": "bun --filter backend build",
    "build:frontend": "bun --filter frontend build",
    "lint": "bun --filter '*' lint",
    "test": "bun --filter backend test",
    "test:cov": "bun --filter backend test:cov",
    "test:e2e": "bun --filter backend test:e2e",
    "test:postman": "bun --filter backend test:postman",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "prod:backend": "bun --filter backend start:prod",
    "prod:frontend": "bun --filter frontend start:prod"
  }
}
